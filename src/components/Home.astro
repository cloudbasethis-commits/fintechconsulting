---
import type { HomeContent } from '../data/home';
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  content: HomeContent;
  lang: Lang;
}
const { content: c, lang } = Astro.props;
const servicesHref = localizePath('/services', lang);
const solutionsHref = localizePath('/solutions', lang);
const moreLabel = lang === 'fr' ? 'En savoir plus' : 'Learn more';
const allSolutionsLabel = lang === 'fr' ? 'Voir toutes nos solutions' : 'See all our solutions';
const redirectUrl =
  lang === 'fr'
    ? 'https://www.fintechconsulting-sa.net/merci'
    : 'https://www.fintechconsulting-sa.net/en/thank-you';

// Icônes par pôle de services (SVG inline, stroke = currentColor)
const groupIcons: Record<string, string> = {
  finance: '<path d="M3 7h18v10H3z"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/>',
  tech: '<path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  conseil: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2.2 4.8-4.8 2.2 2.2-4.8 4.8-2.2z"/>',
};
const dashLabels =
  lang === 'fr'
    ? { board: 'Tableau de bord', vol: 'Volume transactions', uptime: 'Disponibilité', realtime: 'Temps réel', compliant: 'Conformité BCEAO · UEMOA' }
    : { board: 'Dashboard', vol: 'Transaction volume', uptime: 'Uptime', realtime: 'Real time', compliant: 'BCEAO · WAEMU compliant' };
const bars = [38, 62, 50, 78, 64, 90];
---

<!-- ======================= HERO ======================= -->
<section class="relative overflow-hidden bg-ink-950 text-white">
  <div class="glow-teal pointer-events-none absolute inset-0"></div>
  <div
    class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand-600/25 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-28">
    <div>
      <p class="fc-rise fc-d1 mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm font-medium text-teal-200">
        <span class="h-1.5 w-1.5 rounded-full bg-teal-400 fc-pulse"></span>
        {c.hero.eyebrow}
      </p>
      <h1 class="fc-rise fc-d2 max-w-2xl text-4xl font-bold leading-[1.05] sm:text-5xl lg:text-6xl">
        {c.hero.title} <span class="text-gradient">{c.hero.titleAccent}</span>
      </h1>
      <p class="fc-rise fc-d3 mt-6 max-w-xl text-lg leading-relaxed text-ink-300">{c.hero.subtitle}</p>

      <div class="fc-rise fc-d4 mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#contact"
          class="rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition hover:bg-brand-500"
        >
          {c.hero.ctaPrimary}
        </a>
        <a
          href="#services"
          class="rounded-xl border border-white/20 px-6 py-3.5 text-base font-semibold text-white transition hover:bg-white/10"
        >
          {c.hero.ctaSecondary}
        </a>
      </div>

      <ul class="fc-rise fc-d5 mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-300">
        {
          c.hero.badges.map((b) => (
            <li class="flex items-center gap-2">
              <svg class="h-5 w-5 text-teal-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              {b}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Visuel "dashboard fintech" (décoratif, lg+ uniquement) -->
    <div class="fc-rise fc-d3 relative hidden h-[420px] lg:block" aria-hidden="true">
      <div class="absolute right-4 top-2 h-64 w-64 rounded-full border border-teal-400/15"></div>
      <div class="absolute right-16 top-14 h-40 w-40 rounded-full border border-brand-400/15"></div>

      <!-- Carte principale -->
      <div class="absolute left-2 top-10 w-[20rem] rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-2xl shadow-black/40 backdrop-blur-md">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wide text-teal-300">{dashLabels.board}</span>
          <span class="flex gap-1"><span class="h-1.5 w-1.5 rounded-full bg-white/30"></span><span class="h-1.5 w-1.5 rounded-full bg-white/30"></span><span class="h-1.5 w-1.5 rounded-full bg-white/30"></span></span>
        </div>
        <div class="mt-5 flex h-24 items-end gap-2">
          {bars.map((h) => (
            <div class="flex-1 rounded-t bg-gradient-to-t from-brand-600 to-teal-400" style={`height:${h}%`}></div>
          ))}
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
          <div class="rounded-lg bg-white/5 p-3">
            <p class="text-ink-300">{dashLabels.vol}</p>
            <p class="mt-1 text-base font-bold text-white">+128%</p>
          </div>
          <div class="rounded-lg bg-white/5 p-3">
            <p class="text-ink-300">{dashLabels.uptime}</p>
            <p class="mt-1 text-base font-bold text-white">99,9%</p>
          </div>
        </div>
      </div>

      <!-- Carte flottante "temps réel" -->
      <div class="absolute right-0 top-0 w-52 rounded-2xl border border-white/10 bg-ink-900/80 p-4 shadow-xl shadow-black/40 backdrop-blur-md">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-teal-400 fc-pulse"></span>
          <span class="text-xs font-semibold text-white">Switch monétique</span>
        </div>
        <p class="mt-2 text-xs text-ink-300">GIM-UEMOA · {dashLabels.realtime}</p>
        <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
          <div class="h-full w-3/4 rounded-full bg-gradient-to-r from-brand-500 to-teal-400"></div>
        </div>
      </div>

      <!-- Pastille conformité -->
      <div class="absolute bottom-2 left-10 flex items-center gap-2 rounded-full border border-teal-400/30 bg-teal-400/10 px-4 py-2 text-xs font-semibold text-teal-200 backdrop-blur-md">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
        {dashLabels.compliant}
      </div>
    </div>
  </div>
</section>

<!-- ======================= SERVICES ======================= -->
<section id="services" class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{c.services.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-950 sm:text-4xl">{c.services.heading}</h2>
      <p class="mt-4 text-lg text-ink-500">{c.services.subheading}</p>
      <a
        href={servicesHref}
        class="mt-5 inline-flex items-center gap-1.5 font-semibold text-brand-600 hover:text-brand-700"
      >
        {c.services.linkLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-14 space-y-14">
      {
        c.services.groups.map((group) => (
          <div class="reveal">
            <div class="mb-6 flex items-center gap-4 border-b border-ink-100 pb-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={groupIcons[group.id]} />
              </span>
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="text-xl font-semibold text-ink-900">{group.name}</h3>
                <p class="text-ink-500">{group.tagline}</p>
              </div>
            </div>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
              {group.items.map((item) => (
                <a
                  href={item.slug ? localizePath(`/services/${item.slug}`, lang) : servicesHref}
                  class="group flex flex-col rounded-2xl border border-ink-100 bg-ink-50/40 p-6 transition hover:-translate-y-1 hover:border-brand-200 hover:bg-white hover:shadow-lg hover:shadow-ink-900/5"
                >
                  <h4 class="text-base font-semibold text-ink-900 group-hover:text-brand-600">{item.title}</h4>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{item.desc}</p>
                  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
                    {moreLabel}
                    <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ======================= SOLUTIONS ======================= -->
<section id="solutions" class="relative overflow-hidden bg-teal-950 py-20 text-white lg:py-28">
  <div class="glow-teal pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-teal-300 uppercase">{c.solutions.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{c.solutions.heading}</h2>
      <p class="mt-4 text-lg leading-relaxed text-teal-50/90">{c.solutions.subheading}</p>
      <a
        href={solutionsHref}
        class="mt-5 inline-flex items-center gap-1.5 font-semibold text-teal-300 hover:text-teal-200"
      >
        {allSolutionsLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        c.solutions.items.map((s) => (
          <article class="reveal flex flex-col rounded-2xl border border-white/10 bg-white/5 p-7 backdrop-blur-sm transition hover:border-teal-400/30 hover:bg-white/[0.08]">
            <span class="text-xs font-semibold tracking-wide text-teal-300 uppercase">{s.tag}</span>
            <h3 class="mt-2 text-2xl font-bold text-white">{s.name}</h3>
            <p class="mt-3 leading-relaxed text-teal-50/85">{s.desc}</p>
            <ul class="mt-6 space-y-3">
              {s.features.map((f) => (
                <li class="flex items-start gap-3 text-sm text-teal-50/90">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-teal-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            {(s.slug || s.href) && (
              <a
                href={s.slug ? localizePath(`/solutions/${s.slug}`, lang) : s.href}
                {...(s.href && !s.slug ? { target: '_blank', rel: 'noopener' } : {})}
                class="mt-6 inline-flex items-center gap-1.5 self-start text-sm font-semibold text-teal-300 transition hover:text-teal-200"
              >
                {s.cta}
                <span aria-hidden="true">{s.slug ? '→' : '↗'}</span>
              </a>
            )}
          </article>
        ))
      }
    </div>

    <div class="mt-10">
      <a
        href="#contact"
        class="inline-block rounded-xl bg-brand-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-black/20 transition hover:bg-brand-500"
      >
        {c.hero.ctaPrimary}
      </a>
    </div>
  </div>
</section>

<!-- ======================= À PROPOS + STATS ======================= -->
<section id="about" class="bg-white py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-2 lg:px-8">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{c.about.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-950 sm:text-4xl">{c.about.heading}</h2>
      <div class="mt-5 space-y-4 text-lg leading-relaxed text-ink-600">
        {c.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="grid grid-cols-2 gap-5 self-center">
      {
        c.about.stats.map((s) => (
          <div class="reveal rounded-2xl border border-ink-100 bg-ink-50/50 p-7 text-center">
            <div class="js-count text-gradient text-3xl font-bold sm:text-4xl">{s.value}</div>
            <div class="mt-2 text-sm font-medium text-ink-500">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ======================= RÉFÉRENCES ======================= -->
<section id="references" class="bg-ink-50/60 py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{c.references.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-950 sm:text-4xl">{c.references.heading}</h2>
      <p class="mt-4 text-lg text-ink-500">{c.references.subheading}</p>
    </div>
    <!-- Bandeau défilant (marquee) : logos dupliqués pour une boucle continue -->
    <div class="fc-marquee mt-10 overflow-hidden [mask-image:linear-gradient(to_right,transparent,#000_8%,#000_92%,transparent)]">
      <div class="fc-marquee-track flex w-max gap-4">
        {
          [...c.references.clients, ...c.references.clients].map((client) =>
            client.href ? (
              <a
                href={client.href}
                target="_blank"
                rel="noopener"
                aria-label={client.name}
                class="flex h-28 w-44 shrink-0 items-center justify-center rounded-2xl border border-ink-100 bg-white p-6 transition hover:border-brand-200 hover:shadow-md"
              >
                <img src={client.logo} alt={client.name} loading="lazy" class="max-h-14 w-auto object-contain" />
              </a>
            ) : (
              <div class="flex h-28 w-44 shrink-0 items-center justify-center rounded-2xl border border-ink-100 bg-white p-6">
                <img src={client.logo} alt={client.name} loading="lazy" class="max-h-14 w-auto object-contain" />
              </div>
            )
          )
        }
      </div>
    </div>
  </div>
</section>

<!-- ======================= MÉTHODE (timeline) ======================= -->
<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{c.process.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-950 sm:text-4xl">{c.process.heading}</h2>
      <p class="mt-4 text-lg text-ink-500">{c.process.subheading}</p>
    </div>
    <ol class="relative mt-14 grid gap-10 lg:grid-cols-4 lg:gap-6">
      <div class="pointer-events-none absolute left-6 top-6 hidden h-px w-full bg-gradient-to-r from-brand-300 via-teal-300 to-transparent lg:block" aria-hidden="true"></div>
      {
        c.process.steps.map((step, i) => {
          const label = step.title.includes('·') ? step.title.split('·')[1].trim() : step.title;
          return (
            <li class="reveal relative">
              <span class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 text-lg font-bold text-white ring-4 ring-white">
                {i + 1}
              </span>
              <h3 class="mt-5 text-lg font-semibold text-ink-900">{label}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{step.desc}</p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<!-- ======================= CONTACT ======================= -->
<section id="contact" class="bg-ink-50/60 py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-2 lg:px-8">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{c.contact.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-950 sm:text-4xl">{c.contact.heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">{c.contact.intro}</p>
      <div class="mt-8 space-y-3 text-ink-700">
        <p class="flex items-center gap-3">
          <span class="text-brand-600">✉</span>
          <a href="mailto:infos@fintechconsultingsa.com" class="font-medium hover:text-brand-600">infos@fintechconsultingsa.com</a>
        </p>
        <p class="flex items-center gap-3">
          <span class="text-brand-600">☎</span>
          <a href="tel:+2252721570865" class="font-medium hover:text-brand-600">+225 27 21 57 08 65</a>
        </p>
        <p class="flex items-center gap-3">
          <span class="text-brand-600">⌖</span>
          <span>Angré Djorogobité 2, 286 — Abidjan, Côte d’Ivoire</span>
        </p>
      </div>
    </div>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="reveal rounded-2xl border border-ink-100 bg-white p-6 sm:p-8"
    >
      <!-- TODO: remplacer par votre clé d'accès Web3Forms (gratuit, web3forms.com, avec infos@fintechconsultingsa.com) -->
      <input type="hidden" name="access_key" value="VOTRE_CLE_WEB3FORMS" />
      <input type="hidden" name="subject" value="Nouveau message depuis fintechconsulting-sa.net" />
      <input type="hidden" name="from_name" value="Site FinTech Consulting SA" />
      <input type="hidden" name="redirect" value={redirectUrl} />
      <!-- Honeypot anti-spam -->
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <label class="block">
        <span class="text-sm font-medium text-ink-700">{c.contact.name}</span>
        <input
          type="text"
          name="name"
          autocomplete="name"
          required
          class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
        />
      </label>
      <label class="mt-4 block">
        <span class="text-sm font-medium text-ink-700">{c.contact.email}</span>
        <input
          type="email"
          name="email"
          autocomplete="email"
          required
          class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
        />
      </label>
      <label class="mt-4 block">
        <span class="text-sm font-medium text-ink-700">{c.contact.message}</span>
        <textarea
          name="message"
          rows="4"
          required
          class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
        ></textarea>
      </label>
      <button
        type="submit"
        class="mt-5 w-full rounded-xl bg-brand-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700"
      >
        {c.contact.submit}
      </button>
      <p class="mt-3 text-center text-xs text-ink-500">{c.contact.note}</p>
    </form>
  </div>
</section>
