---
import type { SolutionCard } from '../data/solutions';
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  heading: string;
  intro: string;
  items: SolutionCard[];
}
const { lang, heading, intro, items } = Astro.props;
const eyebrow = lang === 'fr' ? 'Nos solutions' : 'Our solutions';
---

<!-- Hero -->
<section class="relative overflow-hidden bg-teal-950 text-white">
  <div class="glow-teal pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-5xl px-5 py-16 lg:px-8 lg:py-20">
    <p class="text-sm font-semibold tracking-wide text-accent-400 uppercase">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">{heading}</h1>
    <p class="mt-4 max-w-2xl text-lg text-teal-50/90">{intro}</p>
  </div>
</section>

<!-- Cartes -->
<section class="bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        items.map((s) => {
          const internal = !!s.slug;
          const href = s.slug ? localizePath(`/solutions/${s.slug}`, lang) : s.href;
          return (
            <a
              href={href}
              {...(!internal ? { target: '_blank', rel: 'noopener' } : {})}
              class="reveal group flex flex-col rounded-2xl border border-ink-100 bg-ink-50/40 p-7 transition hover:-translate-y-1 hover:border-brand-200 hover:bg-white hover:shadow-xl hover:shadow-ink-900/5"
            >
              <span class="text-xs font-semibold tracking-wide text-teal-600 uppercase">{s.tag}</span>
              <h2 class="mt-2 text-2xl font-bold text-ink-950 group-hover:text-brand-600">{s.name}</h2>
              <p class="mt-3 flex-1 leading-relaxed text-ink-500">{s.desc}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                {s.cta}
                <span class="transition group-hover:translate-x-1" aria-hidden="true">{internal ? '→' : '↗'}</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
