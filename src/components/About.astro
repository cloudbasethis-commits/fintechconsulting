---
import type { AboutContent } from '../data/about';
import type { Lang } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';

interface Props {
  content: AboutContent;
  lang: Lang;
}
const { content: c, lang } = Astro.props;
const t = useTranslations(lang);
const contactHref = `${localizePath('/', lang)}#contact`;
const dgMember = c.team.members[0];
const otherMembers = c.team.members.slice(1);
const initials = (name: string) => name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<!-- Hero -->
<section class="relative overflow-hidden bg-ink-950 text-white">
  <div class="glow-teal pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-5xl px-5 py-16 lg:px-8 lg:py-20">
    <p class="text-sm font-semibold tracking-wide text-accent-400 uppercase">{c.heroEyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">{c.heroTitle}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-300">{c.heroSubtitle}</p>
  </div>
</section>

<!-- Story -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <h2 class="text-3xl font-bold text-ink-950">{c.story.heading}</h2>
    <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink-600">
      {c.story.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<!-- Stats -->
<section class="bg-ink-50/60 py-14">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-5 px-5 lg:grid-cols-4 lg:px-8">
    {
      c.stats.map((s) => (
        <div class="reveal rounded-2xl border border-ink-100 bg-white p-7 text-center">
          <div class="js-count text-gradient text-4xl font-bold sm:text-5xl">{s.value}</div>
          <div class="mt-2 text-sm font-medium text-ink-500">{s.label}</div>
        </div>
      ))
    }
  </div>
</section>

<!-- Values -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-5xl px-5 lg:px-8">
    <h2 class="text-3xl font-bold text-ink-950">{c.values.heading}</h2>
    <p class="mt-3 text-lg text-ink-500">{c.values.intro}</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        c.values.items.map((v) => (
          <article class="rounded-2xl border border-ink-100 bg-ink-50/40 p-6">
            <h3 class="text-lg font-semibold text-ink-900">{v.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-500">{v.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Team -->
<section class="bg-ink-50/60 py-16 lg:py-20">
  <div class="mx-auto max-w-5xl px-5 lg:px-8">
    <h2 class="text-3xl font-bold text-ink-950">{c.team.heading}</h2>
    <p class="mt-3 text-lg text-ink-500">{c.team.intro}</p>

    <!-- Directrice Générale en vedette -->
    <article class="reveal mt-8 grid overflow-hidden rounded-3xl border border-ink-100 bg-white sm:grid-cols-[16rem_1fr]">
      {
        dgMember.photo ? (
          <img src={dgMember.photo} alt={dgMember.name} loading="lazy" class="h-72 w-full object-cover object-top sm:h-full" />
        ) : (
          <div class="flex h-72 items-center justify-center bg-brand-600 text-5xl font-bold text-white sm:h-full">
            {initials(dgMember.name)}
          </div>
        )
      }
      <div class="p-7 sm:p-9">
        <span class="inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-700">{dgMember.role}</span>
        <h3 class="mt-4 text-2xl font-bold text-ink-950">{dgMember.name}</h3>
        <p class="mt-4 leading-relaxed text-ink-600">{dgMember.focus}</p>
      </div>
    </article>

    <!-- Les autres membres -->
    <div class="mt-6 grid gap-5 sm:grid-cols-3">
      {
        otherMembers.map((m) => (
          <article class="reveal rounded-2xl border border-ink-100 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-ink-900/5">
            {m.photo ? (
              <img src={m.photo} alt={m.name} width="64" height="64" loading="lazy" class="h-16 w-16 rounded-full object-cover" />
            ) : (
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white">
                {initials(m.name)}
              </span>
            )}
            <h3 class="mt-4 font-semibold text-ink-900">{m.name}</h3>
            <p class="text-sm font-medium text-brand-600">{m.role}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{m.focus}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Expertise -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <h2 class="text-3xl font-bold text-ink-950">{c.expertise.heading}</h2>
    <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink-600">
      {c.expertise.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-5xl px-5 lg:px-8">
    <div class="rounded-3xl bg-ink-950 p-8 text-center text-white sm:p-12">
      <h2 class="text-2xl font-bold sm:text-3xl">{c.ctaHeading}</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-300">{c.ctaText}</p>
      <a
        href={contactHref}
        class="mt-6 inline-block rounded-xl bg-brand-600 px-7 py-3.5 font-semibold text-white transition hover:bg-brand-500"
      >
        {t('common.talk')}
      </a>
    </div>
  </div>
</section>
