---
import type { Service } from '../data/services';
import type { Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { getServices } from '../data/services';

interface Props {
  lang: Lang;
  service: Service;
}
const { lang, service: s } = Astro.props;
const t = useTranslations(lang);
const home = localizePath('/', lang);
const contactHref = `${home}#contact`;

const others = getServices(lang).filter((x) => x.slug !== s.slug);
const labels =
  lang === 'fr'
    ? { what: 'Ce que nous faisons', deliver: 'Ce que vous obtenez', faq: 'Questions fréquentes', other: 'Autres services', back: 'Tous les services' }
    : { what: 'What we do', deliver: 'What you get', faq: 'Frequently asked questions', other: 'Other services', back: 'All services' };

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

<!-- Hero -->
<section class="relative overflow-hidden bg-ink-950 text-white">
  <div class="glow-teal pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-5xl px-5 py-16 lg:px-8 lg:py-20">
    <a href={localizePath('/services', lang)} class="text-sm font-medium text-teal-300 hover:text-teal-200">
      ← {labels.back}
    </a>
    <h1 class="mt-5 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">{s.name}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-300">{s.tagline}</p>
    <a
      href={contactHref}
      class="mt-8 inline-block rounded-xl bg-brand-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-brand-600/25 transition hover:bg-brand-500"
    >
      {t('nav.cta')}
    </a>
  </div>
</section>

<!-- Intro -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <div class="space-y-4 text-lg leading-relaxed text-ink-600">
      {s.intro.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<!-- Offerings -->
<section class="bg-ink-50/60 py-16 lg:py-20">
  <div class="mx-auto max-w-5xl px-5 lg:px-8">
    <h2 class="text-3xl font-bold text-ink-950">{labels.what}</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.offerings.map((o) => (
          <article class="rounded-2xl border border-ink-100 bg-white p-6">
            <h3 class="text-base font-semibold text-ink-900">{o.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{o.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Deliverables -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <h2 class="text-3xl font-bold text-ink-950">{labels.deliver}</h2>
    <ul class="mt-8 space-y-3">
      {
        s.deliverables.map((d) => (
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-5 w-5 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
            <span class="text-ink-700">{d}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- FAQ -->
<section class="bg-ink-50/60 py-16 lg:py-20">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <h2 class="text-3xl font-bold text-ink-950">{labels.faq}</h2>
    <div class="mt-8 space-y-4">
      {
        s.faq.map((f) => (
          <details class="group rounded-2xl border border-ink-100 bg-white p-5">
            <summary class="cursor-pointer list-none font-semibold text-ink-900 marker:hidden">
              <span class="flex items-center justify-between gap-4">
                {f.q}
                <span class="text-brand-600 transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-3 text-ink-600">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- CTA + other services -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-5xl px-5 lg:px-8">
    <div class="rounded-3xl bg-ink-950 p-8 text-center text-white sm:p-12">
      <h2 class="text-2xl font-bold sm:text-3xl">{s.ctaLine}</h2>
      <a
        href={contactHref}
        class="mt-6 inline-block rounded-xl bg-brand-600 px-7 py-3.5 font-semibold text-white transition hover:bg-brand-500"
      >
        {t('common.talk')}
      </a>
    </div>

    <div class="mt-12">
      <h2 class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{labels.other}</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        {
          others.map((o) => (
            <a
              href={localizePath(`/services/${o.slug}`, lang)}
              class="group rounded-xl border border-ink-100 p-5 transition hover:border-brand-200 hover:shadow-md"
            >
              <span class="font-semibold text-ink-900 group-hover:text-brand-600">{o.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
