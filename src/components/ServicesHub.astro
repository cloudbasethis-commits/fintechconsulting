---
import type { Service } from '../data/services';
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  services: Service[];
  heading: string;
  intro: string;
}
const { lang, services, heading, intro } = Astro.props;
---

<section class="bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <header class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-accent-600 uppercase">Services</p>
      <h1 class="mt-3 text-4xl font-bold text-ink-950 sm:text-5xl">{heading}</h1>
      <p class="mt-4 text-lg text-ink-500">{intro}</p>
    </header>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <a
            href={localizePath(`/services/${s.slug}`, lang)}
            class="group flex flex-col rounded-2xl border border-ink-100 bg-ink-50/40 p-7 transition hover:border-brand-200 hover:bg-white hover:shadow-xl hover:shadow-ink-900/5"
          >
            <h2 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">{s.name}</h2>
            <p class="mt-2 flex-1 text-ink-500">{s.tagline}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
              {lang === 'fr' ? 'En savoir plus' : 'Learn more'}
              <span class="transition group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
