---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { getPosts, totalBlogPages, pageSlice, POSTS_PER_PAGE } from '../../../utils/blog';

export async function getStaticPaths() {
  const allPosts = await getPosts('fr');
  const totalPages = totalBlogPages(allPosts.length);
  // Pages 2..n (la page 1 est /blog)
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: { page, totalPages, posts: pageSlice(allPosts, page) },
    };
  });
}

const { page, totalPages, posts } = Astro.props;
---

<BaseLayout
  title={`Blog — page ${page} | FinTech Consulting SA`}
  description="Analyses et conseils sur la finance digitale, la monétique, la cybersécurité, le cloud et la transformation numérique des entreprises en Côte d’Ivoire."
>
  <BlogIndex
    lang="fr"
    posts={posts}
    currentPage={page}
    totalPages={totalPages}
    heading="Le blog FinTech Consulting"
    intro="Finance digitale, monétique, cybersécurité et transformation numérique : nos analyses pour les entreprises de Côte d’Ivoire."
  />
</BaseLayout>
