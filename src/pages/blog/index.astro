---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { getPosts, totalBlogPages, pageSlice } from '../../utils/blog';

const allPosts = await getPosts('fr');
const totalPages = totalBlogPages(allPosts.length);
const posts = pageSlice(allPosts, 1);
---

<BaseLayout
  title="Blog — FinTech Consulting SA | Finance digitale & tech en Côte d’Ivoire"
  description="Analyses et conseils sur la finance digitale, la monétique, la cybersécurité, le cloud et la transformation numérique des entreprises en Côte d’Ivoire."
>
  <BlogIndex
    lang="fr"
    posts={posts}
    currentPage={1}
    totalPages={totalPages}
    heading="Le blog FinTech Consulting"
    intro="Finance digitale, monétique, cybersécurité et transformation numérique : nos analyses pour les entreprises de Côte d’Ivoire."
  />
</BaseLayout>
