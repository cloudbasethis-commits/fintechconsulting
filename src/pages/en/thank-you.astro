---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank you — FinTech Consulting SA"
  description="Your message has been sent. Our team will get back to you within 1 business day."
  noindex={true}
  alternates={{ fr: '/merci', en: '/en/thank-you' }}
>
  <section class="flex min-h-[70vh] items-center justify-center bg-ink-950 px-5 py-20 text-center text-white">
    <div class="max-w-xl">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-600">
        <svg class="h-8 w-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h1 class="mt-6 text-3xl font-bold sm:text-4xl">Thanks, message received!</h1>
      <p class="mt-4 text-lg text-ink-300">
        Your request has been sent. Our team will get back to you within <strong class="text-white">1 business day</strong>.
      </p>
      <p class="mt-2 text-ink-400">In the meantime, feel free to explore our work on the site.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/en/" class="rounded-xl bg-brand-600 px-6 py-3.5 font-semibold text-white transition hover:bg-brand-500">
          Back to home
        </a>
        <a href="/en/blog" class="rounded-xl border border-white/25 px-6 py-3.5 font-semibold text-white transition hover:bg-white/10">
          Read the blog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
